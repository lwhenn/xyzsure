# Copy to .env and fill in values (you can reuse XYZ-LIMS-v2 .env for shared auth/DB/Google).

OAUTHLIB_RELAX_TOKEN_SCOPE=True
FLASK_SECRET_KEY=change-me
FLASK_SESSION_PERMANENT=True
FLASK_PERMANENT_SESSION_LIFETIME=86400
PORT=8090
LOG_LEVEL=INFO

# PostgreSQL — same XYZ_Tools DB as LIMS for User/Role auth (required)
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_DB_NAME=XYZ_Tools
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432

# Google OAuth (GIS login + Drive/Sheets scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS=
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# CAP / Discovery Engine
CAP_SHEET_ID=
CAP_SHEET_NAME=GEN
CAP_COMPLIANCE_SHEET_ID=
DOCUMENT_LIST_GSHEET_ID=
INSPECTION_DOCUMENT_ID=
PROJECT_ID=
LOCATION=us
APP_ID=
SERVING_CONFIG_ID=default_search

# LLM (set at least one)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_DETERMINISTIC=1

# Demo mode for prospects: comma-separated access codes. Each code opens
# /demo/<code> as a read-only session with fictional sample data (no Google/LLM/LIMS calls).
# Leave empty to disable. Use a distinct, hard-to-guess code per prospect or campaign.
DEMO_ACCESS_CODES=
DEMO_SESSION_HOURS=8

# External LIMS API (option 3 — "Include LIMS data" over HTTP)
# Point at XYZ-LIMS after deploying its /v1/compliance/evidence endpoint.
# Token must match LIMS_COMPLIANCE_API_TOKEN on the LIMS server.
# LIMS_API_BASE_URL=https://xyzlapp.com
# LIMS_API_EVIDENCE_PATH=/v1/compliance/evidence
# LIMS_API_METHOD=GET
# LIMS_API_TOKEN=
# LIMS_API_KEY=
# LIMS_API_AUTH_HEADER=
# LIMS_API_EXTRA_HEADERS=
# LIMS_API_TIMEOUT=15
# LIMS_API_FALLBACK_ORM=1
# LIMS_API_HEALTH_PATH=
# LIMS_API_HEALTH_TIMEOUT=5
