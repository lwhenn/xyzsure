{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "XYZSure AI Compliance",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--host", "0.0.0.0", "--port", "8090", "--no-debugger", "--no-reload"],
      "jinja": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "XYZSure app.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "8090"
      }
    }
  ]
}
